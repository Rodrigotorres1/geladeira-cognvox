DATABASE_URL=sqlite:///./cilindros.db
SECRET_KEY=change-this-to-a-random-secret-value
FRONTEND_ORIGIN=http://localhost:5173
# "local" para desenvolvimento (cookie sem Secure, funciona em http://localhost);
# qualquer outro valor (ex.: "production") ativa Secure=True no cookie de sessao
ENVIRONMENT=local
# Opcionais (valores padrao abaixo):
# fuso usado para decidir o que e "hoje" nos alertas de vencimento
# TIMEZONE=America/Sao_Paulo
# meses ate o vencimento para os alertas "atencao" e "urgente"
# MESES_ALERTA_ATENCAO=6
# MESES_ALERTA_URGENTE=2
